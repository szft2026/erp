# 复制成 .env 再改：cp .env.example .env

# ========== 一键部署（docker compose up -d --build）==========
# MySQL root 密码，同时是应用连库用的密码；只在第一次启动时生效
DB_PASSWORD=root123
# 库名
DB_DATABASE=erp
# 空库自动导入 erp.sql（1）；库里有数据设 0
AUTO_INIT_SCHEMA=1
# 1=页面显示 SQL 错误，正式环境建议 0
DB_DEBUG=1

# ========== 接你自己的 MySQL（docker compose -f docker-compose.external.yml up -d --build）==========
# 把下面三项填上；DB_PASSWORD / DB_DATABASE 改成外部库的值，AUTO_INIT_SCHEMA 改 0
# DB_HOST=10.0.0.5
# DB_PORT=3306
# DB_USERNAME=erp
# AUTO_INIT_SCHEMA=0
